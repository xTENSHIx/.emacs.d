(use-package vertico
  :ensure t
  :init
  (vertico-mode 1))

(use-package vertico-multiform
  :after vertico
  :ensure nil)

;; 2. Install the Posframe UI
(use-package vertico-posframe
  :ensure t
  :after vertico
  :config
  (vertico-posframe-mode 1)
  (setq vertico-posframe-poshandler #'vertico-posframe-center-poshandler)
  
  ;; Example: Use the Telescope popup for M-x, but keep normal 
  ;; file searching at the bottom of the screen.
  (setq vertico-multiform-commands
        '((execute-extended-command posframe))))

(provide 'vertico-conf)
